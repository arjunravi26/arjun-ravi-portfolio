---
interface Props {
  number: string;
  title: string;
  summary: string;
  category: string;
  technologies: string[];
  href: string;
}
const { number, title, summary, category, technologies, href } = Astro.props;
---
<article class="project-row">
  <span class="project-number">{number}</span>
  <div class="project-main">
    <div class="project-title-line">
      <h3><a href={href}>{title}<span class="arrow" aria-hidden="true"> ↗</span></a></h3>
      <span class="project-category">{category}</span>
    </div>
    <p>{summary}</p>
    <ul class="tag-list" aria-label="Technologies">
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
</article>
