      <rect x="52" y="198" width="256" height="58" rx="9"/><text x="180" y="223" text-anchor="middle" class="diagram-title">Queue + scheduler</text><text x="180" y="241" text-anchor="middle" class="diagram-sub">Backpressure · fair dispatch</text>
