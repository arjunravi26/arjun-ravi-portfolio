      <marker id="arrowAccent" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6" fill="none" stroke="#2e725c" stroke-width="1.2" /></marker>
    </defs>
    <g class="diagram-label"><text x="30" y="33">REQUEST PATH</text><text x="30" y="245">CANCELLATION PATH</text></g>
    <g class="diagram-box">
      <rect x="28" y="70" width="142" height="92" rx="10"/><text x="99" y="108" text-anchor="middle" class="diagram-title">Requests</text><text x="99" y="130" text-anchor="middle" class="diagram-sub">API clients</text>
      <rect x="220" y="70" width="160" height="92" rx="10"/><text x="300" y="108" text-anchor="middle" class="diagram-title">Token gate</text><text x="300" y="130" text-anchor="middle" class="diagram-sub">Budget admission</text>
      <rect x="430" y="70" width="142" height="92" rx="10"/><text x="501" y="108" text-anchor="middle" class="diagram-title">Queue</text><text x="501" y="130" text-anchor="middle" class="diagram-sub">Backpressure</text>
      <rect x="620" y="70" width="142" height="92" rx="10"/><text x="691" y="108" text-anchor="middle" class="diagram-title">Scheduler</text><text x="691" y="130" text-anchor="middle" class="diagram-sub">Fair dispatch</text>
      <rect x="810" y="70" width="82" height="92" rx="10" class="diagram-box-accent"/><text x="851" y="108" text-anchor="middle" class="diagram-title">GPU</text><text x="851" y="130" text-anchor="middle" class="diagram-sub">vLLM</text>
    </g>
    <g class="diagram-lines" fill="none" marker-end="url(#arrow)">
