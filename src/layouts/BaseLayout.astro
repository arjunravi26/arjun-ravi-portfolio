---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'work' | 'writing';
  noIndex?: boolean;
}

const {
  title = `${site.name} — ${site.role}`,
  description = site.metaDescription,
  active = 'home',
  noIndex = false,
} = Astro.props;
const siteOrigin = Astro.site?.toString();
const canonical = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).toString() : undefined;
const socialLinks = [
  { label: 'GitHub', href: site.github },
  { label: 'Medium', href: site.medium },
  ...(site.linkedin ? [{ label: 'LinkedIn', href: site.linkedin }] : []),
  ...(site.leetcode ? [{ label: 'LeetCode', href: site.leetcode }] : []),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f0" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {siteOrigin && <meta property="og:image" content={new URL('/og.png', siteOrigin).toString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label={`${site.name}, home`}>Arjun Ravi<span>.</span></a>
      <nav class="primary-nav" aria-label="Main navigation">
        <a class:list={[{ active: active === 'work' }]} href={active === 'home' ? '#work' : '/#work'}>Work</a>
        <a class:list={[{ active: active === 'writing' }]} href="/writing/">Writing</a>
        <a href={active === 'home' ? '#contact' : '/#contact'}>Contact</a>
        <a class="nav-resume" href="/resume.pdf" target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div class="footer-top">
        <a class="wordmark" href="/">Arjun Ravi<span>.</span></a>
        <p>AI Engineer · {site.specialization}</p>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <div class="footer-links">
          {socialLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
          <a href={`mailto:${site.email}`}>Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
