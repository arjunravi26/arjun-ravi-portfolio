---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const entries = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---
<BaseLayout title={`Writing — ${site.name}`} description="Selected Medium articles by Arjun Ravi on AI engineering, model serving, retrieval, GPU computing and training." active="writing">
  <div class="shell">
    <header class="page-intro">
      <a class="back-link" href="/">← Back home</a>
      <p class="eyebrow">Writing / Archive</p>
      <h1>Notes on building AI systems.</h1>
      <p>I write about building and operating AI systems: model serving, retrieval, model internals, fine-tuning and the engineering decisions around them. This is a curated index of selected articles hosted on Medium.</p>
    </header>
    <section class="archive-section">
      <div class="writing-preview">
        {entries.length > 0 ? entries.map((entry) => (
          <article class="writing-entry">
            <time class="writing-date" datetime={entry.data.date?.toISOString()}>{entry.data.date ? entry.data.date.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) : 'Undated'}</time>
            <div>
              <h3>
                {entry.data.type === 'external' && entry.data.externalUrl
                  ? <a href={entry.data.externalUrl} target="_blank" rel="noreferrer">{entry.data.title} <span class="arrow" aria-hidden="true">↗</span></a>
                  : <a href={`/writing/${entry.id}/`}>{entry.data.title} <span class="arrow" aria-hidden="true">↗</span></a>}
              </h3>
              <p>{entry.data.summary}</p>
              <div class="writing-meta"><span>{entry.data.category}</span><span>·</span><span>{entry.data.type === 'external' ? 'Read on Medium' : 'Read on this site'}</span></div>
            </div>
          </article>
        )) : (
          <div class="writing-current">
            <h2>Writing on Medium</h2>
            <p>Medium is where I currently publish technical articles. This page is a curated index for selected pieces and longer essays hosted here; each entry includes a short note about what it covers. For the complete list, browse my Medium profile.</p>
            <a href={site.medium} target="_blank" rel="noreferrer">Browse my Medium profile <span aria-hidden="true">↗</span></a>
          </div>
        )}
      </div>
      {entries.length > 0 && <a class="text-link" href={site.medium} target="_blank" rel="noreferrer">Visit my Medium profile <span aria-hidden="true">↗</span></a>}
    </section>
  </div>
</BaseLayout>
