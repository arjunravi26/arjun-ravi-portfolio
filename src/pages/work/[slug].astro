---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InferenceDiagram from '../../components/InferenceDiagram.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, category, technologies, period, metrics, repository, confidential } = project.data;
const showInferenceDiagram = project.id === 'inference-gateway';
---
<BaseLayout title={`${title} — ${'Arjun Ravi'}`} description={summary} active="work">
  <div class="shell">
    <header class="case-study-header">
      <a class="back-link" href="/#work">← Back to selected work</a>
      <p class="eyebrow">{category} / Case study</p>
      <h1>{title}</h1>
      <p class="case-study-summary">{summary}</p>
      <div class="case-meta">
        {period && <span>{period}</span>}
        <span>{technologies.join(' · ')}</span>
        {confidential && <span>Client details withheld</span>}
      </div>
      {metrics.length > 0 && (
        <div class="case-metrics">
          {metrics.map((metric) => (
            <div class="case-metric"><strong>{metric.value}</strong><span>{metric.label}{metric.note ? ` — ${metric.note}` : ''}</span></div>
          ))}
        </div>
      )}
    </header>
    {showInferenceDiagram && <InferenceDiagram />}
    <article class="case-content">
      <div class="prose"><Content /></div>
      {repository && <p class="article-end">Source code: <a href={repository} target="_blank" rel="noreferrer">View repository ↗</a></p>}
    </article>
  </div>
</BaseLayout>
