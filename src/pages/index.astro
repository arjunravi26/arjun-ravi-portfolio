---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { site, proofPoints, timeline, education, skillGroups } from '../data/site';

const allWork = await getCollection('work');
const featuredWork = allWork.filter((entry) => entry.data.featured).sort((a, b) => a.data.order - b.data.order);
const allWriting = await getCollection('writing', ({ data }) => !data.draft);
const recentWriting = allWriting.sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)).slice(0, 3);
const social = [
  { label: 'Email', href: `mailto:${site.email}` },
  { label: 'GitHub', href: site.github, external: true },
  { label: 'Medium', href: site.medium, external: true },
  ...(site.linkedin ? [{ label: 'LinkedIn', href: site.linkedin, external: true }] : []),
  ...(site.leetcode ? [{ label: 'LeetCode', href: site.leetcode, external: true }] : []),
  { label: 'Resume PDF', href: '/resume.pdf', external: true },
];
---
<BaseLayout title={`${site.name} — ${site.role}`} description={site.metaDescription}>
  <div class="shell">
  <section class="hero" aria-labelledby="hero-title">
  <div class="hero-layout">
    <div class="hero-content">
      <p class="eyebrow">
        {site.role} <span aria-hidden="true">/</span> {site.specialization}
      </p>

      <h1 id="hero-title">{site.headline}</h1>

      <p class="hero-copy">{site.intro}</p>
      <p class="hero-copy">{site.introSecond}</p>

      <div class="hero-status">
        <span class="status-dot" aria-hidden="true"></span>
        {site.availability} <span aria-hidden="true">·</span> {site.location}
      </div>

      <div class="hero-links">
        {social.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noreferrer' : undefined}
          >
            {item.label}{item.external && <span aria-hidden="true"> ↗</span>}
          </a>
        ))}
      </div>
    </div>

    <img
      class="profile-photo"
      src="/profile_enchanced.jpeg"
      alt="Portrait of Arjun Ravi"
      width="124"
      height="124"
    />
  </div>
</section>

    <section class="section contribution-section" id="contributions">
      <SectionHeading index="01" eyebrow="Measured outcomes" title="My contributions" />
      <div class="proof-strip">
        {proofPoints.map((point, index) => (
          <article class:list={["proof-item", { "proof-item-featured": index === 1 }]}>
            <div class="proof-value">{point.value}{point.unit && <span class="proof-unit">{point.unit}</span>}</div>
            <p class="proof-label">{point.label}</p>
            <p class="proof-note">{point.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="work">
      <SectionHeading index="02" eyebrow="Projects" title="Selected work" />
      <div class="project-list">
        {featuredWork.map((entry, index) => (
          <ProjectRow
            number={`0${index + 1}`}
            title={entry.data.title}
            summary={entry.data.summary}
            category={entry.data.category}
            technologies={entry.data.technologies}
            href={`/work/${entry.id}/`}
          />
        ))}
      </div>
      <p class="project-footnote">Each page covers the problem, what I built, and the measured result. Company work is described without identifying the client.</p>
    </section>


    <section class="section" id="building">
      <SectionHeading index="03" eyebrow="Independent work" title="Building to understand" />
      <div class="building-list">
        <article class="building-item">
          <h3><a href="/work/attention-tokenizers/">Attention architecture & tokenizer internals ↗</a></h3>
          <p>Five attention variants (single-head, MHA, MQA, GQA, sliding-window) and BPE tokenizers, implemented from scratch in PyTorch to understand how architecture choices affect memory and speed.</p>
        </article>
        <p class="building-footnote">Outside the featured work: 80+ GitHub repositories and 300+ LeetCode problems solved.</p>
      </div>
    </section>

    <section class="section" id="experience">
      <SectionHeading index="04" eyebrow="Career & education" title="Experience" />
      <div class="timeline">
        {timeline.map((item) => (
          <article class="timeline-item">
            <time class="timeline-period">{item.period}</time>
            <div>
              <h3 class="timeline-role">{item.role}</h3>
              <p class="timeline-org">{item.organization}</p>
              <p class="timeline-description">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
      </section>


    <section class="section" id="tools">
      <SectionHeading index="05" eyebrow="Technical range" title="Tools & technologies" />
      <div class="skills-list">
        {skillGroups.map((group) => (
          <div class="skill-row">
            <h3>{group.label}</h3>
            <p>{group.items}</p>
          </div>
        ))}
      </div>
    </section>


    <section class="section" id="education">
      <SectionHeading index="06" eyebrow="Education" title="Education" />
      <div class="education">
        <div>
          <h3>{education.qualification}</h3>
          <p>{education.institution} · {education.detail}</p>
        </div>
        <span class="education-period">{education.period}</span>
      </div>
    </section>

    <section class="section" id="writing">
      <SectionHeading index="07" eyebrow="Articles" title="Writing" />
      <p class="section-intro">Selected articles on model serving, retrieval, model internals, fine-tuning and the engineering decisions around them.</p>
      <div class="writing-preview">
        {recentWriting.length > 0 ? recentWriting.map((entry) => (
          <article class="writing-entry">
            <time class="writing-date" datetime={entry.data.date?.toISOString()}>{entry.data.date ? entry.data.date.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) : 'Undated'}</time>
            <div>
              <h3>
                {entry.data.type === 'external' && entry.data.externalUrl
                  ? <a href={entry.data.externalUrl} target="_blank" rel="noreferrer">{entry.data.title} <span class="arrow" aria-hidden="true">↗</span></a>
                  : <a href={`/writing/${entry.id}/`}>{entry.data.title} <span class="arrow" aria-hidden="true">↗</span></a>}
              </h3>
              <p>{entry.data.summary}</p>
              <div class="writing-meta"><span>{entry.data.category}</span><span>·</span><span>{entry.data.type === 'external' ? 'Medium' : 'On this site'}</span></div>
            </div>
          </article>
        )) : (
          <div class="writing-current">
            <p>I write about AI engineering, model internals, inference, retrieval and training systems.</p>
            <a href={site.medium} target="_blank" rel="noreferrer">Read my writing on Medium <span aria-hidden="true">↗</span></a>
          </div>
        )}
      </div>
      <a class="text-link" href="/writing/">Browse the writing archive <span aria-hidden="true">→</span></a>
    </section>

    <section class="section" id="contact">
      <SectionHeading index="08" eyebrow="Get in touch" title="Contact" />
      <div class="contact-block">
        <h3>Get in touch.</h3>
        <p>For AI engineering and inference roles, project discussions, or technical conversations, email is the best way to reach me.</p>
        <div class="contact-links">
          <a href={`mailto:${site.email}`}>Email ↗</a>
          <a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href={site.medium} target="_blank" rel="noreferrer">Medium ↗</a>
          {site.linkedin && <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>}
          {site.leetcode && <a href={site.leetcode} target="_blank" rel="noreferrer">LeetCode ↗</a>}
          <a href="/resume.pdf" target="_blank" rel="noreferrer">Resume PDF ↗</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
